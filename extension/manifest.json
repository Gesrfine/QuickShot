{
  "manifest_version": 3,
  "name": "QuickShot",
  "version": "2.0.2",
  "description": "将任意来源的剪贴板新图片快捷粘贴到绑定的 Edge 页面，最后由你手动发送。",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "QuickShot · 绑定目标",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
