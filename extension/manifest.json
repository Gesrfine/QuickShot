{
  "manifest_version": 3,
  "name": "快投 QuickShot · 截图接收目标",
  "version": "1.3.6",
  "description": "将 FastStone 截图快捷投递到你绑定的 Edge 聊天标签页。图片通过系统剪贴板粘贴，消息由你手动发送。",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "快投 · 绑定这个聊天",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
