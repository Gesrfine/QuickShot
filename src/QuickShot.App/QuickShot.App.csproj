<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>QuickShot</AssemblyName>
    <Version>2.0.1</Version>
    <Title>QuickShot</Title>
    <Product>QuickShot</Product>
    <Company>QuickShot</Company>
    <Description>将剪贴板新图片快捷粘贴到绑定的 Edge 页面</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../QuickShot.Core/QuickShot.Core.csproj" />
  </ItemGroup>
</Project>

